# Environment Variables - Topçam Güvenlik Sistemleri

# Production site URL — Vercel'de Environment Variables > NEXT_PUBLIC_SITE_URL olarak ayarlanmalıdır.
# Local geliştirme için bu dosyayı .env.local olarak kopyalayabilirsiniz.
# .env.local git'e commit EDİLMEZ (.gitignore'da engellidir).

NEXT_PUBLIC_SITE_URL=https://topcamguvenlik.com

# Resend — İletişim formu teklif bildirim e-postaları için.
# https://resend.com/api-keys adresinden API key alabilirsiniz.
# Vercel > Settings > Environment Variables'a da RESEND_API_KEY olarak eklenmelidir.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
