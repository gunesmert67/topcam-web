{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "features/*/index.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "features/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "config/**/*.{ts,tsx}"
  ],
  "ignore": [
    "components/ui/**",
    "config/routes.ts",
    "lib/**"
  ],
  "ignoreDependencies": [
    "tw-animate-css",
    "tailwindcss"
  ]
}
