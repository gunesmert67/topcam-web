{
  "name": "topcam-guvenlik-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "madge": "madge --circular --extensions ts,tsx ./",
    "architecture-check": "depcruise --config .dependency-cruiser.js app/ features/ components/ lib/ config/",
    "test:security": "node --no-warnings scripts/security-audit.mjs",
    "verify": "npm run typecheck && npm run lint && npm run knip && npm run madge && npm run architecture-check && npm run test:security",
    "ci": "npm run verify && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "knip": "^6.27.0",
    "madge": "^8.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "browserslist": [
    "defaults and fully supports es6-module and fully supports es6-module-dynamic-import",
    "chrome >= 115",
    "edge >= 115",
    "firefox >= 115",
    "safari >= 16.4",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ]
}
